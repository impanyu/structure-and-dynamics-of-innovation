# Copy this file to `.env` (repo root) and fill in your keys.
# `.env` is gitignored — never commit real keys.
# The CLI loads it automatically; shell environment variables take precedence.

# Needed for models prefixed `openai:` (current config: summarizer/agent/judge)
OPENAI_API_KEY=

# Needed only for un-prefixed (Anthropic) models
ANTHROPIC_API_KEY=

# Optional: Semantic Scholar API key (faster corpus fetching, no 429 stalls)
# Apply free at https://www.semanticscholar.org/product/api
# (not yet wired into the client; tell Claude if you get one)
